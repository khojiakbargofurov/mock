# ── Telegram bot orqali kirish ────────────────────────────────────────────
# 1. Telegram'da @BotFather'ga yozing → /newbot → nom va username bering
# 2. BotFather bergan tokenni shu yerga qo'ying (hech qachon commit qilmang)
TELEGRAM_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Bot username'i (@ belgisisiz) — deep-link shundan yasaladi
TELEGRAM_BOT_USERNAME=german_mock_test_bot
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=german_mock_test_bot

# Webhook uchun maxfiy so'z: Telegram har so'rovda shu qiymatni yuboradi
# (setWebhook'da secret_token sifatida bering). Lokal ishlab chiqishda ixtiyoriy.
TELEGRAM_WEBHOOK_SECRET=uzun-tasodifiy-satr

# Sessiya cookie'sini imzolash kaliti (kamida 16 belgi).
# Yaratish: openssl rand -base64 32
AUTH_SECRET=uzun-tasodifiy-satr-almashtiring

# ── Supabase (ma'lumotlar bazasi) ─────────────────────────────────────────
# Supabase → Project Settings → API
# URL: "Project URL" · Kalit: "service_role" (secret!) — anon emas
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...
